# Only the PUBLISHABLE key belongs in the browser. Never put a service-role,
# database, AI provider or Razorpay secret in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional branding / support (safe to expose to the browser)
VITE_APP_NAME=FlowSuite
VITE_SUPPORT_EMAIL=support@flow-suit.com

# ---------------------------------------------------------------------------
# Server-only secrets. Set these in Supabase Dashboard > Project Settings >
# Edge Functions / Secrets (or via `supabase secrets set`). NEVER add them to
# this file, .env.local, or any VITE_* variable.
# ---------------------------------------------------------------------------
# NOTIFY_EMAIL_SECRET=<long random value; required by the notify-email function>
# EMAIL_PROVIDER=resend            # or omit for the no-op console adapter
# EMAIL_PROVIDER_API_KEY=<provider key>
# EMAIL_FROM_ADDRESS=FlowSuite <notifications@your-domain.example>
